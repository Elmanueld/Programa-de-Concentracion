<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

    <appSettings>
        <add key="SmtpHost" value="" />
        <add key="SmtpPuerto" value="587" />
        <add key="SmtpSsl" value="true" />
        <add key="SmtpRemitente" value="" />
        <add key="SmtpUsuario" value="" />
    </appSettings>

	<connectionStrings>
		<add name="conexion"
			 connectionString="Server=.\SQLEXPRESS;Database=ProgramaConcentracion;Integrated Security=True;"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>
